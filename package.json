  },
  "dependencies": {
    "phaser": "4.2.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "25.9.0",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
